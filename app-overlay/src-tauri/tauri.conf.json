{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guide Dofus Overlay",
  "version": "1.0.0",
  "identifier": "io.github.neocrizis.guidedofus",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Neocrizis",
    "shortDescription": "Guide Dofus en overlay par-dessus le jeu",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French"], "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["guidedofus"] } }
  }
}
